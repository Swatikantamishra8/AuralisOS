# ==============================================================================
# AuralisOS Hermetic Debian ISO Builder Container
# Base: Debian 13 (Trixie) Slim
# Capabilities: live-build, debootstrap, GTK4/Layer-Shell C compilation, Go toolchain
# Target: Production Hybrid BIOS/UEFI Live ISO with glibc & OpenRC (<130MB Idle)
# ==============================================================================

FROM debian:trixie-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    live-build \
    debootstrap \
    squashfs-tools \
    xorriso \
    isolinux \
    syslinux-common \
    syslinux-efi \
    grub-efi-amd64-bin \
    grub-pc-bin \
    mtools \
    dosfstools \
    gcc \
    make \
    pkg-config \
    libgtk-4-dev \
    libgtk4-layer-shell-dev \
    libadwaita-1-dev \
    golang-go \
    git \
    curl \
    ca-certificates \
    sudo \
    procps \
    fakeroot \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

CMD ["/bin/bash"]
